{
  "rewrites": [],
  "functions": {
    "api/shopify-checkout.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/create-checkout-session.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/cj-order.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/cj-webhook.js": {
      "memory": 128,
      "maxDuration": 5
    },
    "api/product-lookup.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/categories-lookup.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/search-products.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/shopify-order.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/sync-products.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/setup-shopify.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/shopify-webhook.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/sync-inventory.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/sync-cj-orders.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/track-order.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/register-shopify-webhooks.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/cron-sync.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/debug-env.js": {
      "memory": 128,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/account-info.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-sync?task=inventory",
      "schedule": "0 3 * * *
    },
    {
      "path": "/api/cron-sync?task=orders",
      "schedule": "0 */6 * * *
    }
  ]
}